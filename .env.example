# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_WORKSPACE_CLIENT_ID & GOOGLE_WORKSPACE_CLIENT_SECRET:
# OAuth 2.0 Credentials for Google Drive & Workspace integration.
GOOGLE_WORKSPACE_CLIENT_ID=
GOOGLE_WORKSPACE_CLIENT_SECRET=

# FIRECRAWL_API_KEY: Optional API Key for Firecrawl AI Web Scraping & Crawling service.
FIRECRAWL_API_KEY=

# SUPABASE_URL & SUPABASE_ANON_KEY: Direct integration with Supabase Vector Database & Cloud Storage
SUPABASE_URL=
SUPABASE_ANON_KEY=
# [SEC-07/08] SERVICE ROLE KEY (server-side): dùng để GHI dữ liệu store trong khi vẫn BẬT RLS.
# CHỈ đặt ở server, KHÔNG bao giờ để lộ ra client. Nếu để trống, server dùng ANON key (yêu cầu policy phù hợp).
SUPABASE_SERVICE_ROLE_KEY=

# --- [MỚI - Giai đoạn 1 bảo mật] API key các nhà cung cấp AI (chỉ cấu hình phía server) ---
# Từ nay client KHÔNG còn nhập/lưu API key. Đặt key tại đây trên máy chủ.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
# Custom OpenAI-compatible endpoint (Ollama/LM Studio/Proxy) — thay cho ô nhập ở client
CUSTOM_OPENAI_ENDPOINT=
CUSTOM_OPENAI_API_KEY=

# ALLOWED_ORIGINS: Danh sách origin được phép gọi các endpoint quản trị/ghi (phân tách bằng dấu phẩy).
# Ví dụ: https://admin.example.com,http://localhost:3000
# Để trống trong môi trường dev; BẮT BUỘC đặt ở production để siết CORS.
ALLOWED_ORIGINS=

# --- [MỚI - Xác thực quản trị bằng Supabase Auth] ---
# Bật xác thực cho toàn bộ endpoint quản trị/ghi. Đặt "true" ở production.
AUTH_ENABLED=false
# Yêu cầu SUPABASE_URL và SUPABASE_ANON_KEY (ở trên) đã được cấu hình.
# Giới hạn email được phép đăng nhập quản trị (phân tách bằng dấu phẩy). Để trống = cho phép mọi tài khoản Supabase hợp lệ.
ADMIN_EMAILS=admin@doanhnghiep.com
# Bí mật ký tham số OAuth `state` (tách phiên Google theo người dùng). Nên đặt cố định ở production.
OAUTH_STATE_SECRET=

# --- [MỚI - SEC-12] Giới hạn kích thước body & rate limit ---
# Kích thước body tối đa (ảnh/PDF base64). Mặc định 15mb.
MAX_BODY_SIZE=15mb
# Cửa sổ rate limit (ms) và số request tối đa mỗi IP trong cửa sổ.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_CHAT_MAX=20

# --- [PoC RAG] Truy hồi ngữ nghĩa (tối ưu chi phí AI) ---
# Bật RAG cho /api/chat: chỉ đưa các đoạn tri thức liên quan vào prompt thay vì nhồi toàn bộ.
# Yêu cầu: Supabase (đã bật extension vector + bảng kb_chunks + hàm match_kb_chunks) và GEMINI_API_KEY.
RAG_ENABLED=false
# Tự động cập nhật chỉ mục RAG khi thêm/sửa tri thức (chỉ nguồn mới/đổi, không đụng backlog). Tắt: RAG_AUTO_INDEX=false
RAG_AUTO_INDEX=true
# Số đoạn tối đa xử lý mỗi lần bấm "Xây chỉ mục" (backlog). Kho lớn: bấm lại nhiều lần để cộng dồn.
RAG_MAX_CHUNKS=3000
